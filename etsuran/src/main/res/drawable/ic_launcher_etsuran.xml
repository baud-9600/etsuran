<?xml version="1.0" encoding="utf-8"?>
<!--
  Browser: a tabbed window with a globe in it, in the Mudita Kompakt stock style
  (81 grid, ring r=19.25 x 2.5, glyph stroke 2.5, black on transparent).

  The tab is what separates this from a generic window glyph; the globe is the
  universal browser mark. Everything is geometric and drawn on the same 2.5-unit
  line as the ring, so it stays black-and-white at launcher size and needs no
  anti-aliased grey to read.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="81dp"
    android:height="81dp"
    android:viewportWidth="81"
    android:viewportHeight="81">

    <!-- the rounded-square ring every Kompakt icon wears -->
    <path
        android:pathData="M19.25,2.5C9.999,2.5 2.5,9.999 2.5,19.25V61.75C2.5,71.001 9.999,78.5 19.25,78.5H61.75C71.001,78.5 78.5,71.001 78.5,61.75V19.25C78.5,9.999 71.001,2.5 61.75,2.5H19.25ZM0,19.25C0,8.619 8.619,0 19.25,0H61.75C72.382,0 81,8.619 81,19.25V61.75C81,72.382 72.382,81 61.75,81H19.25C8.619,81 0,72.382 0,61.75V19.25Z"
        android:fillColor="#FF000000"
        android:fillType="evenOdd" />

    <!-- browser tab -->
    <path
        android:pathData="M24,20V17A1.5,1.5 0 0 1 25.5,15.5H37A1.5,1.5 0 0 1 38.5,17V20"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- window and its chrome line -->
    <path
        android:pathData="M22,20H59A5,5 0 0 1 64,25V56A5,5 0 0 1 59,61H22A5,5 0 0 1 17,56V25A5,5 0 0 1 22,20Z"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M17,28H64"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="2.5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M22.5,24m-1.1,0a1.1,1.1 0 1,0 2.2,0a1.1,1.1 0 1,0 -2.2,0"
        android:fillColor="#FF000000" />

    <!-- globe: outline, meridian, equator -->
    <path
        android:pathData="M40.5,33.5a10.5,10.5 0 1,0 0,21a10.5,10.5 0 1,0 0,-21"
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
