# Copy to keystore.properties next to this file and fill in the values.
# The real file is git-ignored, as is the keystore itself (*.keystore).
#
# The shared asdfghasdfgh signing key also lives outside the repository:
#   ~/asdfghasdfgh-release.keystore
#   ~/asdfghasdfgh-signing/asdfghasdfgh-keystore.properties
# Copy both into another project to sign its APKs with the same identity.
storeFile=signing/signing.keystore
storePassword=change-me
keyAlias=asdfghasdfgh
keyPassword=change-me
